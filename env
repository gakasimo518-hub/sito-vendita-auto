<?php
class Car {
    private $pdo;

    public function __construct($pdo) {
        $this->pdo = $pdo;
    }

    public function getAll($filters = []) {
        $sql = "SELECT * FROM cars WHERE 1=1";
        $params = [];
        if (!empty($filters['make'])) {
            $sql .= " AND make = :make";
            $params[':make'] = $filters['make'];
        }
        if (!empty($filters['model'])) {
            $sql .= " AND model = :model";
            $params[':model'] = $filters['model'];
        }
        if (!empty($filters['min_price'])) {
            $sql .= " AND price >= :min_price";
            $params[':min_price'] = $filters['min_price'];
        }
        if (!empty($filters['max_price'])) {
            $sql .= " AND price <= :max_price";
            $params[':max_price'] = $filters['max_price'];
        }
        $stmt = $this->pdo->prepare($sql);
        $stmt->execute($params);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    public function getById($id) {
        $stmt = $this->pdo->prepare("SELECT * FROM cars WHERE id = :id");
        $stmt->execute([':id' => $id]);
        return $stmt->fetch(PDO::FETCH_ASSOC);
    }

    public function create($data) {
        $sql = "INSERT INTO cars (make, model, year, price, description, image_url) VALUES (:make, :model, :year, :price, :description, :image_url)";
        $stmt = $this->pdo->prepare($sql);
        $stmt->execute([
            ':make' => $data['make'],
            ':model' => $data['model'],
            ':year' => $data['year'],
            ':price' => $data['price'],
            ':description' => $data['description'],
            ':image_url' => $data['image_url']
        ]);
        return $this->pdo->lastInsertId();
    }

    public function update($id, $data) {
        $sql = "UPDATE cars SET make = :make, model = :model, year = :year, price = :price, description = :description, image_url = :image_url WHERE id = :id";
        $stmt = $this->pdo->prepare($sql);
        return $stmt->execute([
            ':make' => $data['make'],
            ':model' => $data['model'],
            ':year' => $data['year'],
            ':price' => $data['price'],
            ':description' => $data['description'],
            ':image_url' => $data['image_url'],
            ':id' => $id
        ]);
    }

    public function delete($id) {
        $stmt = $this->pdo->prepare("DELETE FROM cars WHERE id = :id");
        return $stmt->execute([':id' => $id]);
    }
}
