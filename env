<?php
$carModel = new Car($pdo);

if ($method === 'GET') {
    $filters = [];
    if (!empty($_GET['make'])) $filters['make'] = $_GET['make'];
    if (!empty($_GET['model'])) $filters['model'] = $_GET['model'];
    if (!empty($_GET['min_price'])) $filters['min_price'] = $_GET['min_price'];
    if (!empty($_GET['max_price'])) $filters['max_price'] = $_GET['max_price'];
    $cars = $carModel->getAll($filters);
    Response::json($cars);
} elseif ($method === 'POST') {
    $data = json_decode(file_get_contents('php://input'), true);
    if (!Validator::required($data['make']) || !Validator::required($data['model']) || !Validator::numeric($data['year']) || !Validator::numeric($data['price'])) {
        Response::error('Invalid input', 400);
    }
    $id = $carModel->create($data);
    Response::json(['id' => $id], 201);
} elseif ($method === 'PUT') {
    $data = json_decode(file_get_contents('php://input'), true);
    $id = $data['id'] ?? null;
    if (!$id) {
        Response::error('ID required', 400);
    }
    $updateData = [
        'make' => $data['make'] ?? '',
        'model' => $data['model'] ?? '',
        'year' => $data['year'] ?? '',
        'price' => $data['price'] ?? '',
        'description' => $data['description'] ?? '',
        'image_url' => $data['image_url'] ?? ''
    ];
    $carModel->update($id, $updateData);
    Response::json(['message' => 'Updated']);
} elseif ($method === 'DELETE') {
    $data = json_decode(file_get_contents('php://input'), true);
    $id = $data['id'] ?? null;
    if (!$id) {
        Response::error('ID required', 400);
    }
    $carModel->delete($id);
    Response::json(['message' => 'Deleted']);
} else {
    Response::error('Method not allowed', 405);
}
